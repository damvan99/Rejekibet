<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% const _title = meta.title ? meta.title + ' — Rejekibet' : 'Rejekibet — Berita, Ulasan & Panduan Game'; const _desc = meta.description || 'Portal berita, ulasan, dan panduan game berbahasa Indonesia.'; const _img = siteUrl + (meta.image || '/cover/rejekibet.svg'); %>
<title><%= _title %></title>
<meta name="description" content="<%= _desc %>">
<% if (meta.noindex) { %><meta name="robots" content="noindex"><% } %>
<link rel="canonical" href="<%= siteUrl + currentPath %>">
<meta property="og:site_name" content="Rejekibet">
<meta property="og:type" content="<%= meta.type || 'website' %>">
<meta property="og:title" content="<%= _title %>">
<meta property="og:description" content="<%= _desc %>">
<meta property="og:image" content="<%= _img %>">
<meta property="og:url" content="<%= siteUrl + currentPath %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0b0d12">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip" href="#konten">Langsung ke konten</a>
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Rejekibet beranda"><span class="logo-mark" aria-hidden="true"></span>Rejeki<b>bet</b></a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Buka menu"><span></span><span></span><span></span></button>
    <nav id="nav" class="nav" aria-label="Navigasi utama">
      <% const _nav = [['/kategori/berita','Berita'],['/kategori/ulasan','Ulasan'],['/kategori/panduan','Panduan'],['/kategori/esports','Esports'],['/game','Direktori Game']]; %>
      <% _nav.forEach(([href, label]) => { %><a href="<%= href %>"<%- currentPath.startsWith(href) ? ' aria-current="page"' : '' %>><%= label %></a><% }) %>
      <form class="search" action="/cari" role="search">
        <label class="sr" for="q">Cari artikel atau game</label>
        <input id="q" name="q" type="search" placeholder="Cari game, ulasan…" minlength="2" required>
        <button aria-label="Cari"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      </form>
    </nav>
  </div>
</header>
<main id="konten">
