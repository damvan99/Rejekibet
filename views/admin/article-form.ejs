<%- include('_top', { pageTitle: item.id ? 'Ubah artikel' : 'Artikel baru' }) %>
<div class="admin-head"><h1><%= item.id ? 'Ubah artikel' : 'Artikel baru' %></h1><a class="btn btn-ghost" href="/admin/artikel">← Kembali</a></div>
<% if (error) { %><div class="flash flash-err" role="alert"><%= error %></div><% } %>
<form method="post" enctype="multipart/form-data" action="/admin/artikel/<%= item.id || 'baru' %>?_csrf=<%= csrf %>" class="form form-grid">
  <div class="form-main">
    <label>Judul<input name="title" value="<%= item.title %>" maxlength="160" required></label>
    <label>Ringkasan <small>Tampil di kartu dan hasil pencarian Google (maks. 300 karakter)</small><textarea name="excerpt" rows="3" maxlength="300"><%= item.excerpt %></textarea></label>
    <label>Isi artikel <small>Format Markdown: ## Subjudul, **tebal**, - daftar, > kutipan, [teks](tautan)</small><textarea name="content" rows="22" class="mono"><%= item.content %></textarea></label>
  </div>
  <div class="form-side">
    <div class="panel">
      <label class="check"><input type="checkbox" name="published" value="1" <%= item.published ? 'checked' : '' %>> Terbitkan</label>
      <label class="check"><input type="checkbox" name="featured" value="1" <%= item.featured ? 'checked' : '' %>> Jadikan artikel utama beranda</label>
      <button class="btn">Simpan</button>
    </div>
    <div class="panel">
      <label>Kategori<select name="category"><% Object.entries(CATEGORIES).forEach(([k, c]) => { %><option value="<%= k %>" <%= item.category === k ? 'selected' : '' %>><%= c.label %></option><% }) %></select></label>
      <label>Penulis<input name="author" value="<%= item.author %>" maxlength="60"></label>
      <label>Game terkait<select name="game_id"><option value="">— Tidak ada —</option><% games.forEach((g) => { %><option value="<%= g.id %>" <%= item.game_id === g.id ? 'selected' : '' %>><%= g.title %></option><% }) %></select></label>
      <label>Slug URL <small>Kosongkan untuk dibuat otomatis</small><input name="slug" value="<%= item.slug || '' %>"></label>
    </div>
    <div class="panel">
      <label>Gambar sampul <small>JPG, PNG, atau WebP · maks. 5 MB · rasio 16:9</small><input type="file" name="cover" accept="image/jpeg,image/png,image/webp"></label>
      <% if (item.cover) { %><img class="thumb" src="/uploads/<%= item.cover %>" alt="Sampul saat ini"><label class="check"><input type="checkbox" name="remove_cover" value="1"> Hapus sampul ini</label><% } else { %><p class="muted small">Tanpa gambar, sampul dibuat otomatis.</p><% } %>
    </div>
  </div>
</form>
<%- include('_bottom') %>
