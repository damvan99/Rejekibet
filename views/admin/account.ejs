<%- include('_top', { pageTitle: 'Akun' }) %>
<div class="admin-head"><h1>Akun</h1></div>
<% if (error) { %><div class="flash flash-err" role="alert"><%= error %></div><% } %>
<form method="post" action="/admin/akun" class="form panel narrow">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Ganti password</h2>
  <label>Password saat ini<input name="current_password" type="password" autocomplete="current-password" required></label>
  <label>Password baru <small>Minimal 10 karakter</small><input name="new_password" type="password" autocomplete="new-password" minlength="10" required></label>
  <label>Ulangi password baru<input name="confirm_password" type="password" autocomplete="new-password" minlength="10" required></label>
  <button class="btn">Simpan password</button>
</form>
<%- include('_bottom') %>
