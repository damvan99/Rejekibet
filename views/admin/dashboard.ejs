<%- include('_top', { pageTitle: 'Dasbor' }) %>
<div class="admin-head"><h1>Dasbor</h1><a class="btn" href="/admin/artikel/baru">+ Artikel baru</a></div>
<div class="stats">
  <div><span>Artikel</span><strong><%= stats.articles %></strong></div>
  <div><span>Draf</span><strong><%= stats.drafts %></strong></div>
  <div><span>Game</span><strong><%= stats.games %></strong></div>
  <div><span>Total dibaca</span><strong><%= stats.views.toLocaleString('id-ID') %></strong></div>
</div>
<div class="two">
  <section class="panel">
    <h2>Artikel terbaru</h2>
    <% if (!recent.length) { %><p class="muted">Belum ada artikel.</p><% } %>
    <ul class="list">
      <% recent.forEach((a) => { %>
      <li><a href="/admin/artikel/<%= a.id %>"><%= a.title %></a><span class="muted"><%= CATEGORIES[a.category].label %> · <%= formatDate(a.created_at) %><%= a.published ? '' : ' · Draf' %></span></li>
      <% }) %>
    </ul>
  </section>
  <section class="panel">
    <h2>Paling banyak dibaca</h2>
    <ul class="list">
      <% top.forEach((a) => { %><li><a href="/admin/artikel/<%= a.id %>"><%= a.title %></a><span class="muted"><%= a.views.toLocaleString('id-ID') %> kali dibaca</span></li><% }) %>
    </ul>
  </section>
</div>
<%- include('_bottom') %>
