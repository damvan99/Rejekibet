# Salin file ini menjadi .env lalu isi nilainya
NODE_ENV=production
PORT=3000
SITE_URL=https://domain-anda.com
# Chuỗi ngẫu nhiên dài: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang
# Tài khoản admin được tạo ở lần chạy đầu tiên
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-password-ini
